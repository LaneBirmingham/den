# systemd unit for a persistent room on a Linux machine.
#
#   sudo useradd --system --home /var/lib/tailchat --create-home tailchat
#   sudo install -m755 target/release/tailchat /usr/local/bin/
#   sudo cp deploy/tailchat.service /etc/systemd/system/ && sudo systemctl enable --now tailchat
#   journalctl -u tailchat | grep "join with"     # the invite link
#
# Open UDP 8245 (the room) and TCP 8245 (its relay) in the firewall, and
# forward both on the router.
[Unit]
Description=tailchat room
Wants=network-online.target
After=network-online.target

[Service]
User=tailchat
Environment=TAILCHAT_HOME=/var/lib/tailchat
ExecStart=/usr/local/bin/tailchat serve --no-console
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tailchat
PrivateTmp=true

[Install]
WantedBy=multi-user.target
