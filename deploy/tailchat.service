# systemd unit for a persistent room on a Linux machine already on your tailnet.
#
#   sudo useradd --system --home /var/lib/tailchat --create-home tailchat
#   sudo tailscale set --operator=tailchat      # lets the service run `tailscale whois`
#   sudo install -m755 target/release/tailchat /usr/local/bin/
#   sudo cp deploy/tailchat.service /etc/systemd/system/ && sudo systemctl enable --now tailchat
#   journalctl -u tailchat -f
[Unit]
Description=tailchat room
Wants=network-online.target tailscaled.service
After=network-online.target tailscaled.service

[Service]
User=tailchat
Environment=TAILCHAT_HOME=/var/lib/tailchat
# Wait for a tailnet address before binding to it.
ExecStartPre=/bin/sh -c 'for i in $(seq 60); do tailscale ip -4 >/dev/null 2>&1 && exit 0; sleep 1; done; exit 1'
ExecStart=/usr/local/bin/tailchat serve --no-console
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tailchat
PrivateTmp=true

[Install]
WantedBy=multi-user.target
